[Unit]
Description=Star Building — Смотритель (кодификатор)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/roman/17-two-bots-split
EnvironmentFile=/home/roman/.config/star-building/bots.env
ExecStart=/srv/hermes-agent/venv/bin/python3 /home/roman/17-two-bots-split/bot_1_codifier.py
